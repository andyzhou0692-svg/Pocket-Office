{
  "name": "pixtuoid-site",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "test:unit": "node --test \"config/**/*.test.mjs\"",
    "verify": "npm run format:check && npm run lint && npm run check && npm run knip && npm run test:unit && npm run build",
    "lighthouse": "lhci autorun",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/jersey-10": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/monaspace-neon": "^5.3.0",
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.12.0",
    "knip": "^6.35.1",
    "mermaid": "^12.0.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "rehype-mermaid": "^3.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1",
    "yaml-language-server": {
      "yaml": "2.8.3"
    }
  }
}
